{
  "name": "swarmcode-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config webpack.config.cjs",
    "build": "NODE_ENV=production webpack --config webpack.config.cjs",
    "build:win": "set NODE_ENV=production&& webpack --config webpack.config.cjs",
    "lint": "eslint .",
    "preview": "npx serve dist -l 3000",
    "test": "npx jest --config jest.config.cjs --runInBand",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config e2e/playwright.config.ts --headed"
  },
  "dependencies": {
