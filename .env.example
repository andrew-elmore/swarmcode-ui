# SwarmCode UI - Environment Variables
# Copy this file to .env and fill in your values.

# Parse Server API URL (default: local dev server)
REACT_APP_PARSE_URL=http://localhost:1337/parse

# Parse Server App ID
REACT_APP_PARSE_APP_ID=swarmcode

# Parse Server REST API Key
REACT_APP_PARSE_REST_API_KEY=rest-api-key-change-me

# Parse LiveQuery WebSocket URL (for real-time updates)
# Local dev: ws://localhost:1337/parse
# Prod: wss://swarmcode-api-616102704370.us-central1.run.app/parse
REACT_APP_PARSE_LIVEQUERY_URL=ws://localhost:1337/parse
